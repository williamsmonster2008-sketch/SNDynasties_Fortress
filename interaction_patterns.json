{
  "$schema": "interaction_pattern_schema_v1",
  "version": "1.0.0",
  "lastModified": "2025-11-02",
  "description": "南北朝坞堡模拟器 - 双人/多人互动模式配置表",
  
  "interactions": [
    {
      "id": "greet_casual",
      "name": "问候",
      "displayName": "寒暄问候",
      "category": "social_basic",
      "description": "简单的日常问候",
      
      "participantRequirements": {
        "minParticipants": 2,
        "maxParticipants": 2,
        "initiatorRequirements": {
          "states": {
            "happiness": { "min": 20 }
          },
          "virtues": {
            "礼": { "min": 20 }
          }
        },
        "targetRequirements": {
          "states": {
            "anger": { "max": 60 }
          }
        }
      },
      
      "relationshipRequirements": {
        "familiarity": { "min": 0 },
        "compatibility": { "min": -50 }
      },
      
      "validLocations": ["井台", "街道", "广场", "市集"],
      "validTimeOfDay": ["清晨", "白昼", "傍晚"],
      
      "phases": [
        {
          "phaseId": "approach",
          "phaseName": "接近",
          "duration": 5,
          "actions": [
            {
              "characterRole": "initiator",
              "action": "走近目标",
              "description": "{initiator} 向 {target} 走去"
            }
          ]
        },
        {
          "phaseId": "greet",
          "phaseName": "问候",
          "duration": 10,
          "actions": [
            {
              "characterRole": "initiator",
              "action": "问候",
              "description": "{initiator} 对 {target} 点头示意"
            },
            {
              "characterRole": "target",
              "action": "回应",
              "description": "{target} 回礼",
              "successChance": 0.85
            }
          ]
        }
      ],
      
      "outcomes": {
        "success": {
          "probability": 0.85,
          "effects": {
            "initiator": {
              "needs": { "social": 10 },
              "states": { "happiness": 5 }
            },
            "target": {
              "needs": { "social": 10 },
              "states": { "happiness": 5 }
            },
            "relationship": {
              "familiarity": 2,
              "compatibility": 1
            }
          },
          "memory": {
            "importance": 10,
            "emotionalImpact": 5,
            "description": "与{target}简单问候"
          }
        },
        "failure": {
          "probability": 0.15,
          "effects": {
            "initiator": {
              "states": { "shame": 10 }
            },
            "target": {
              "states": { "contempt": 5 }
            },
            "relationship": {
              "compatibility": -2
            }
          }
        }
      },
      
      "duration": 15,
      "priority": 40,
      "canBeRejected": true,
      "interruptible": true,
      
      "tags": ["社交", "简单", "日常", "低风险"]
    },
    
    {
      "id": "collaborate_work",
      "name": "协作劳动",
      "displayName": "共同劳作",
      "category": "cooperation",
      "description": "两人一起完成生产任务",
      
      "participantRequirements": {
        "minParticipants": 2,
        "maxParticipants": 4,
        "initiatorRequirements": {
          "needs": {
            "energy": { "min": 40 }
          },
          "skills": {
            "农耕": { "min": 10 }
          }
        },
        "targetRequirements": {
          "needs": {
            "energy": { "min": 30 }
          }
        }
      },
      
      "relationshipRequirements": {
        "familiarity": { "min": 20 },
        "compatibility": { "min": 10 }
      },
      
      "validLocations": ["农田", "作坊"],
      "validTimeOfDay": ["白昼"],
      
      "phases": [
        {
          "phaseId": "negotiate",
          "phaseName": "协商",
          "duration": 10,
          "actions": [
            {
              "characterRole": "initiator",
              "action": "提议协作",
              "description": "{initiator} 邀请 {target} 一起劳作"
            },
            {
              "characterRole": "target",
              "action": "同意/拒绝",
              "description": "{target} 考虑片刻",
              "successChance": 0.7
            }
          ]
        },
        {
          "phaseId": "work_together",
          "phaseName": "共同劳作",
          "duration": 120,
          "actions": [
            {
              "characterRole": "all",
              "action": "劳动",
              "description": "{initiator} 和 {target} 一起干活"
            }
          ],
          "efficiencyBonus": 1.3
        },
        {
          "phaseId": "conclude",
          "phaseName": "结束",
          "duration": 5,
          "actions": [
            {
              "characterRole": "all",
              "action": "休息",
              "description": "他们一起休息片刻"
            }
          ]
        }
      ],
      
      "outcomes": {
        "success": {
          "probability": 0.7,
          "effects": {
            "initiator": {
              "needs": { "energy": -25, "social": 20 },
              "skills": { "农耕": 3 },
              "states": { "happiness": 15 }
            },
            "target": {
              "needs": { "energy": -25, "social": 20 },
              "skills": { "农耕": 3 },
              "states": { "happiness": 15 }
            },
            "relationship": {
              "familiarity": 5,
              "compatibility": 10,
              "cooperation": 8
            }
          },
          "resourceProduction": {
            "粮食": { "amount": 8, "splitBetween": "all" }
          },
          "memory": {
            "importance": 40,
            "emotionalImpact": 20,
            "description": "与{target}一起劳作，配合默契"
          }
        },
        "failure": {
          "probability": 0.3,
          "effects": {
            "initiator": {
              "states": { "frustration": 15 }
            },
            "target": {
              "states": { "frustration": 15 }
            },
            "relationship": {
              "compatibility": -5,
              "cooperation": -3
            }
          },
          "memory": {
            "importance": 30,
            "emotionalImpact": -10,
            "description": "与{target}协作不顺"
          }
        }
      },
      
      "duration": 135,
      "priority": 60,
      "canBeRejected": true,
      "interruptible": true,
      
      "virtueImpact": {
        "义": 2,
        "信": 1
      },
      
      "tags": ["协作", "生产", "技能成长", "关系增进"]
    },
    
    {
      "id": "conflict_argue",
      "name": "争执",
      "displayName": "口角争执",
      "category": "conflict",
      "description": "因矛盾产生的口角",
      
      "participantRequirements": {
        "minParticipants": 2,
        "maxParticipants": 2,
        "initiatorRequirements": {
          "states": {
            "anger": { "min": 50 }
          }
        },
        "targetRequirements": {}
      },
      
      "relationshipRequirements": {
        "compatibility": { "max": -20 }
      },
      
      "validLocations": ["任意公共地点"],
      "validTimeOfDay": ["白昼", "傍晚"],
      
      "phases": [
        {
          "phaseId": "provoke",
          "phaseName": "挑衅",
          "duration": 5,
          "actions": [
            {
              "characterRole": "initiator",
              "action": "指责",
              "description": "{initiator} 对 {target} 提出指责"
            }
          ]
        },
        {
          "phaseId": "escalate",
          "phaseName": "升级",
          "duration": 15,
          "actions": [
            {
              "characterRole": "target",
              "action": "反驳/忍让",
              "description": "{target} 做出反应",
              "choices": [
                {
                  "action": "反驳",
                  "probability": 0.6,
                  "nextPhase": "argue"
                },
                {
                  "action": "忍让",
                  "probability": 0.4,
                  "nextPhase": "resolve"
                }
              ]
            }
          ]
        },
        {
          "phaseId": "argue",
          "phaseName": "争吵",
          "duration": 30,
          "actions": [
            {
              "characterRole": "all",
              "action": "激烈争吵",
              "description": "{initiator} 和 {target} 激烈争吵"
            }
          ]
        },
        {
          "phaseId": "resolve",
          "phaseName": "平息",
          "duration": 10,
          "actions": [
            {
              "characterRole": "all",
              "action": "冷静",
              "description": "争执逐渐平息"
            }
          ]
        }
      ],
      
      "outcomes": {
        "escalated": {
          "probability": 0.6,
          "effects": {
            "initiator": {
              "states": { "anger": -20, "shame": 10 }
            },
            "target": {
              "states": { "anger": 30, "hate": 15 }
            },
            "relationship": {
              "compatibility": -20,
              "familiarity": 5,
              "conflict": 15
            }
          },
          "memory": {
            "importance": 60,
            "emotionalImpact": -40,
            "description": "与{target}发生激烈争吵"
          }
        },
        "resolved": {
          "probability": 0.4,
          "effects": {
            "initiator": {
              "states": { "anger": -30 }
            },
            "target": {
              "states": { "anger": -10 }
            },
            "relationship": {
              "compatibility": -5
            }
          },
          "memory": {
            "importance": 30,
            "emotionalImpact": -10,
            "description": "与{target}的小冲突"
          }
        }
      },
      
      "duration": 60,
      "priority": 70,
      "canBeRejected": false,
      "interruptible": true,
      
      "tags": ["冲突", "高风险", "关系破坏"]
    },
    
    {
      "id": "feast_together",
      "name": "共饮聚宴",
      "displayName": "聚餐饮宴",
      "category": "social_entertainment",
      "description": "多人一起饮酒聚餐",
      
      "participantRequirements": {
        "minParticipants": 3,
        "maxParticipants": 8,
        "initiatorRequirements": {
          "needs": {
            "social": { "min": 20 }
          },
          "states": {
            "happiness": { "min": 40 }
          }
        }
      },
      
      "relationshipRequirements": {
        "familiarity": { "min": 30 }
      },
      
      "validLocations": ["井台", "民居", "酒肆"],
      "validTimeOfDay": ["傍晚", "夜晚"],
      
      "phases": [
        {
          "phaseId": "gather",
          "phaseName": "聚集",
          "duration": 15,
          "actions": [
            {
              "characterRole": "initiator",
              "action": "邀请众人",
              "description": "{initiator} 招呼众人聚集"
            },
            {
              "characterRole": "participants",
              "action": "到场",
              "description": "众人陆续到场"
            }
          ]
        },
        {
          "phaseId": "feast",
          "phaseName": "宴饮",
          "duration": 90,
          "actions": [
            {
              "characterRole": "all",
              "action": "饮酒作乐",
              "description": "众人欢饮畅谈"
            }
          ]
        },
        {
          "phaseId": "disperse",
          "phaseName": "散席",
          "duration": 10,
          "actions": [
            {
              "characterRole": "all",
              "action": "告别",
              "description": "众人尽兴而归"
            }
          ]
        }
      ],
      
      "outcomes": {
        "success": {
          "probability": 0.8,
          "effects": {
            "all": {
              "needs": { "social": 40, "hunger": 30 },
              "states": { "happiness": 35, "boredom": -30 }
            },
            "relationship": {
              "familiarity": 8,
              "compatibility": 12,
              "groupBonding": 15
            }
          },
          "resourceCosts": {
            "食物": 2,
            "酒": 3
          },
          "memory": {
            "importance": 50,
            "emotionalImpact": 35,
            "description": "与众人聚饮，尽兴而归"
          }
        }
      },
      
      "duration": 115,
      "priority": 45,
      "canBeRejected": true,
      "interruptible": false,
      
      "virtueImpact": {
        "仁": 1,
        "礼": 2
      },
      
      "tags": ["社交", "娱乐", "多人", "关系增进"]
    }
  ],
  
  "interactionCategories": {
    "social_basic": {
      "name": "基础社交",
      "description": "日常简单社交互动",
      "riskLevel": "low"
    },
    "cooperation": {
      "name": "协作类",
      "description": "需要配合完成的活动",
      "riskLevel": "medium"
    },
    "conflict": {
      "name": "冲突类",
      "description": "负面对抗性互动",
      "riskLevel": "high"
    },
    "social_entertainment": {
      "name": "社交娱乐",
      "description": "休闲娱乐性质的社交",
      "riskLevel": "low"
    }
  },
  
  "globalSettings": {
    "maxConcurrentInteractions": 50,
    "interactionCooldown": 10,
    "memoryRetentionDays": 30,
    "relationshipDecayRate": 0.1
  }
}
